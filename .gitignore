.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Test coverage
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*
.DS_Store
Thumbs.db
desktop.ini

# === AI / Claude ===
.claude/
.claude.json
.aider*

