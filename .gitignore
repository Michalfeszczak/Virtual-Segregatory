# ============================================
# Virtual Segregatory - .gitignore
# Chroni dokumenty użytkownika i dane wrażliwe przed wyciekiem do gita
# ============================================

# === DANE UŻYTKOWNIKA (NIGDY do gita!) ===
# Foldery z dokumentami PDF
/imports/
/exports/
/backups/
/data/
/cache/
/tmp/
/logs/

# Bazy danych SQLite (wszystkie warianty)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Wszystkie pliki PDF (na wypadek wszelki - mogą zawierać dane wrażliwe)
*.pdf

# Logi i temp
*.log
*.tmp
*.temp
*.bak

# Pliki Excel/CSV/raportów (mogą zawierać dane wrażliwe)
*.xlsx
*.xls
*.csv
*.ods

# === PYTHON ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
